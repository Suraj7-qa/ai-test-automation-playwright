{
  "pageName": "ElectronicsPage",
  "pageUrl": "/electronics",
  "pageTitle": "Demo Web Shop. Electronics",
  "elements": {
    "electronicsHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "Electronics",
      "exact": true,
      "type": "heading",
      "description": "Electronics category heading"
    },
    "headerTopMenu": {
      "locator": "ul.top-menu",
      "fallbackLocators": ["ul[class*='top-menu']"],
      "type": "navigation",
      "description": "Main header category navigation"
    },
    "cameraPhotoLink": {
      "locator": "a[href='/camera-photo'][title]",
      "fallbackLocators": ["h2 a[href='/camera-photo']"],
      "type": "link",
      "description": "Camera, photo subcategory link"
    },
    "cellPhonesLink": {
      "locator": "a[href='/cell-phones'][title]",
      "fallbackLocators": ["h2 a[href='/cell-phones']"],
      "type": "link",
      "description": "Cell phones subcategory link"
    },
    "cameraPhotoHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "Camera, photo",
      "exact": true,
      "type": "heading",
      "description": "Camera, photo category heading"
    },
    "cellPhonesHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "Cell phones",
      "exact": true,
      "type": "heading",
      "description": "Cell phones category heading"
    },
    "under500Filter": {
      "locator": "a[href*='price=-500']",
      "strategy": "role",
      "role": "link",
      "name": "Under 500.00",
      "exact": true,
      "type": "link",
      "description": "Camera, photo price filter under 500.00"
    },
    "over500Filter": {
      "locator": "a[href*='price=500-']",
      "strategy": "role",
      "role": "link",
      "name": "Over 500.00",
      "exact": true,
      "type": "link",
      "description": "Camera, photo price filter over 500.00"
    },
    "handycamLink": {
      "locator": "a[href='/hard-drive-handycam-camcorder']",
      "strategy": "role",
      "role": "link",
      "name": "1MP 60GB Hard Drive Handycam Camcorder",
      "exact": true,
      "type": "link",
      "description": "Handycam product link"
    },
    "handycamPrice": {
      "locator": ".item-box:has(a[href='/hard-drive-handycam-camcorder']) .prices .price",
      "fallbackLocators": [".item-box:has(a[href='/hard-drive-handycam-camcorder']) [class*='price']"],
      "type": "text",
      "description": "Handycam price in the Camera, photo listing"
    },
    "smartphoneLink": {
      "locator": "a[href='/smartphone']",
      "strategy": "role",
      "role": "link",
      "name": "Smartphone",
      "exact": true,
      "type": "link",
      "description": "Smartphone product link"
    },
    "smartphonePrice": {
      "locator": ".item-box:has(a[href='/smartphone']) .prices .price",
      "fallbackLocators": [".item-box:has(a[href='/smartphone']) [class*='price']"],
      "type": "text",
      "description": "Smartphone price in the Cell phones listing"
    },
    "camcorderLink": {
      "locator": "a[href='/camcorder']",
      "strategy": "role",
      "role": "link",
      "name": "Camcorder",
      "exact": true,
      "type": "link",
      "description": "Camcorder product link"
    },
    "digitalSlrLink": {
      "locator": "a[href='/digital-slr-camera']",
      "strategy": "role",
      "role": "link",
      "name": "Digital SLR Camera 12.2 Mpixel",
      "exact": true,
      "type": "link",
      "description": "Digital SLR product link"
    },
    "highDefinitionCamcorderLink": {
      "locator": "a[href='/3d-camcorder']",
      "strategy": "role",
      "role": "link",
      "name": "High Definition 3D Camcorder",
      "exact": true,
      "type": "link",
      "description": "High Definition 3D Camcorder product link"
    },
    "sortByDropdown": {
      "locator": "select[id*='products-orderby']",
      "fallbackLocators": ["select[id*='sort']", ".sort-by select"],
      "strategy": "label",
      "name": "Sort by:",
      "exact": false,
      "type": "select",
      "description": "Catalogue sort order"
    },
    "viewModeDropdown": {
      "locator": "select[id*='products-viewmode']",
      "fallbackLocators": ["select[id*='viewmode']", ".view-mode select"],
      "strategy": "label",
      "name": "View:",
      "exact": false,
      "type": "select",
      "description": "Catalogue view mode (Grid/List)"
    },
    "pageSizeDropdown": {
      "locator": "select[id*='products-pagesize']",
      "fallbackLocators": ["select[id*='pagesize']", ".page-size select"],
      "strategy": "label",
      "name": "Display:",
      "exact": false,
      "type": "select",
      "description": "Products per page"
    },
    "handycamDetailHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "1MP 60GB Hard Drive Handycam Camcorder",
      "exact": true,
      "type": "heading",
      "description": "Handycam detail page heading"
    },
    "smartphoneDetailHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "Smartphone",
      "exact": true,
      "type": "heading",
      "description": "Smartphone detail page heading"
    },
    "detailAddToCartButton": {
      "locator": "button[id*='add-to-cart'], input[id*='add-to-cart']",
      "fallbackLocators": [".add-to-cart-button"],
      "strategy": "role",
      "role": "button",
      "name": "Add to cart",
      "exact": true,
      "type": "button",
      "description": "Add to cart button on product detail page"
    },
    "detailEmailFriendButton": {
      "locator": "a[href*='productemailafriend'], button:has-text('Email a friend')",
      "strategy": "role",
      "role": "button",
      "name": "Email a friend",
      "exact": true,
      "type": "button",
      "description": "Email a friend button on detail page"
    },
    "detailCompareButton": {
      "locator": "a[href*='comparelist'], button:has-text('Add to compare list')",
      "strategy": "role",
      "role": "button",
      "name": "Add to compare list",
      "exact": true,
      "type": "button",
      "description": "Add to compare list button on detail page"
    },
    "detailReviewLink": {
      "locator": "a[href*='productreviews']",
      "strategy": "role",
      "role": "link",
      "name": "Reviews",
      "exact": true,
      "type": "link",
      "description": "Product reviews link on detail page"
    },
    "addToCartNotification": {
      "locator": ".bar-notification",
      "fallbackLocators": [".message-success", "[class*='notification']"],
      "type": "status",
      "description": "Add-to-cart success notification"
    },
    "searchInput": {
      "locator": "input[id='small-searchterms']",
      "fallbackLocators": ["input[name='q']", "#small-search-box-form input[type='text']"],
      "strategy": "css",
      "type": "textbox",
      "description": "Search input field"
    },
    "searchButton": {
      "locator": "button[type='submit'][value='Search'], input[value='Search'], button:has-text('Search')",
      "strategy": "role",
      "role": "button",
      "name": "Search",
      "exact": true,
      "type": "button",
      "description": "Search submit button"
    }
  }
}