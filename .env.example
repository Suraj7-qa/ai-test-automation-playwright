# Demo Web Shop - Environment Configuration
# Copy this file to .env and update values

# Application URLs
BASE_URL=https://demowebshop.tricentis.com
LOGIN_URL=https://demowebshop.tricentis.com/login
REGISTER_URL=https://demowebshop.tricentis.com/register

# Test Credentials (Create a test account on demowebshop.tricentis.com)
TEST_USER_EMAIL=your-test-email@example.com
TEST_USER_PASSWORD=your-secure-password

# New User Registration Data (Used for registration tests)
NEW_USER_FIRST_NAME=John
NEW_USER_LAST_NAME=Doe
NEW_USER_GENDER=Male
NEW_USER_PASSWORD=Password123!

# Environment
ENVIRONMENT=qa

# Browser Settings
HEADLESS=true
SLOW_MO=0

# Timeouts (milliseconds)
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
TEST_TIMEOUT=60000

# Retry Settings
RETRIES_CI=2
RETRIES_LOCAL=0

# Reporting
REPORTER=html,json,junit
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure
TRACE=on-first-retry