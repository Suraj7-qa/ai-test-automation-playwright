{
  "pageName": "PasswordRecoveryPage",
  "pageUrl": "/passwordrecovery",
  "pageTitle": "Demo Web Shop. Password Recovery",
  "elements": {
    "emailInput": {
      "locator": "input[id='Email'], input[name='Email'], input[type='email']",
      "fallbackLocators": [
        "input[id='Email']",
        "input[name='Email']",
        "input[type='email']",
        "#Email"
      ],
      "strategy": "label",
      "name": "Your email address:",
      "exact": false,
      "type": "textbox",
      "description": "Email address input field for password recovery"
    },
    "recoverButton": {
      "locator": "button[type='submit'], input[value='Recover']",
      "fallbackLocators": [
        "button[type='submit']",
        "input[value='Recover']",
        "button:has-text('Recover')",
        ".recover-button"
      ],
      "strategy": "role",
      "role": "button",
      "name": "Recover",
      "exact": true,
      "type": "button",
      "description": "Recover password submit button"
    },
    "backToLoginLink": {
      "locator": "a:has-text('Back to login'), a[href*='login']",
      "fallbackLocators": [
        "a:has-text('Back to login')",
        "a[href*='login']",
        "a[href='/login']"
      ],
      "strategy": "css",
      "type": "link",
      "description": "Back to login link"
    },
    "successMessage": {
      "locator": ".content .result, .message-success, .content:has-text('Email with instructions has been sent')",
      "fallbackLocators": [
        ".content .result",
        ".message-success",
        ".content:has-text('Email with instructions has been sent')",
        ".result"
      ],
      "strategy": "text",
      "name": "Email with instructions has been sent",
      "exact": false,
      "type": "text",
      "description": "Password recovery success message"
    },
    "errorMessage": {
      "locator": ".validation-summary-errors, .field-validation-error, .message-error, span[data-valmsg-for='Email']",
      "fallbackLocators": [
        ".validation-summary-errors",
        ".field-validation-error",
        ".message-error",
        "span[data-valmsg-for='Email']"
      ],
      "type": "text",
      "description": "Password recovery error message"
    },
    "emailNotFoundError": {
      "locator": ".validation-summary-errors ul li:has-text('Email not found'), .field-validation-error:has-text('Email not found')",
      "fallbackLocators": [
        ".validation-summary-errors ul li:has-text('Email not found')",
        ".field-validation-error:has-text('Email not found')",
        "span[data-valmsg-for='Email'].field-validation-error:has-text('Email not found')"
      ],
      "strategy": "text",
      "name": "Email not found",
      "exact": false,
      "type": "text",
      "description": "Email not found error message"
    },
    "pageTitle": {
      "locator": "h1:has-text('Password recovery'), .page-title h1",
      "fallbackLocators": [
        "h1:has-text('Password recovery')",
        ".page-title h1"
      ],
      "strategy": "role",
      "role": "heading",
      "name": "Password recovery",
      "exact": true,
      "type": "heading",
      "description": "Password recovery page title"
    },
    "recoveryForm": {
      "locator": "form[action*='passwordrecovery'], form[data-testid='recovery-form'], .recovery-form",
      "fallbackLocators": [
        "form[action*='passwordrecovery']",
        "form[data-testid='recovery-form']",
        ".recovery-form"
      ],
      "type": "form",
      "description": "Password recovery form container"
    }
  },
  "forms": {
    "recoveryForm": {
      "locator": "form[action*='passwordrecovery'], form[data-testid='recovery-form']",
      "fields": ["emailInput"],
      "submitButton": "recoverButton"
    }
  }
}