{
  "pageName": "ComputersPage",
  "pageUrl": "/computers",
  "pageTitle": "Demo Web Shop. Computers",
  "elements": {
    "categoryHeading": {
      "locator": ".page-title h1, h1.page-title, .page-title",
      "fallbackLocators": ["h1", ".category-title"],
      "strategy": "css",
      "type": "heading",
      "description": "Current category heading (dynamic based on page)"
    },
    "headerTopMenu": {
      "locator": "ul.top-menu",
      "fallbackLocators": ["ul[class*='top-menu']"],
      "type": "navigation",
      "description": "Main header category navigation"
    },
    "computersSubcategoryLinks": {
      "locator": "h2 a[href='/desktops'], h2 a[href='/notebooks'], h2 a[href='/accessories']",
      "type": "link",
      "description": "Computers subcategory links"
    },
    "sidebarDesktopsLink": {
      "locator": ".block-category-navigation .listbox li a[href='/desktops']",
      "strategy": "css",
      "type": "link",
      "description": "Desktops sidebar link"
    },
    "sidebarNotebooksLink": {
      "locator": ".block-category-navigation .listbox li a[href='/notebooks']",
      "fallbackLocators": [".block-category-navigation a[href='/notebooks']:first-of-type"],
      "strategy": "css",
      "type": "link",
      "description": "Notebooks sidebar link"
    },
    "sidebarAccessoriesLink": {
      "locator": ".block-category-navigation .listbox li a[href='/accessories']",
      "fallbackLocators": [".block-category-navigation a[href='/accessories']:first-of-type"],
      "strategy": "css",
      "type": "link",
      "description": "Accessories sidebar link"
    },

    "productCards": {
      "locator": ".item-box",
      "fallbackLocators": [".product-item", "[class*='product-card']"],
      "type": "container",
      "description": "Product cards in a computer category"
    },
    "productNameLinks": {
      "locator": ".item-box .product-title a",
      "type": "link",
      "description": "Product title links in the category catalogue"
    },
    "productCardImage": {
      "locator": ".picture img",
      "fallbackLocators": [".product-image img", "img[alt*='Picture of']"],
      "type": "image",
      "description": "Product image within a catalogue card"
    },
    "productCardPrice": {
      "locator": ".prices .price, .actual-price, .price-value, .price",
      "fallbackLocators": [".prices .price", ".actual-price", "[class*='price']"],
      "type": "text",
      "description": "Product price within a catalogue card"
    },
    "sortByDropdown": {
      "locator": "select[id*='products-orderby']",
      "fallbackLocators": [
        "select[id*='sort']",
        ".sort-by select"
      ],
      "strategy": "css",
      "type": "select",
      "description": "Catalogue sort order"
    },

    "desktopPriceUnder1000": {
      "locator": "a[href*='price=-1000']",
      "fallbackLocators": [
        "a:has-text('Under 1000.00')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "Under 1000.00",
      "exact": true,
      "type": "link",
      "description": "Desktop price filter under 1000.00"
    },
    "desktopPrice1000To1200": {
      "locator": "a[href*='price=1000-1200']",
      "fallbackLocators": [
        "a:has-text('1000.00 - 1200.00')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "1000.00 - 1200.00",
      "exact": true,
      "type": "link",
      "description": "Desktop price filter from 1000.00 to 1200.00"
    },
    "desktopPriceOver1200": {
      "locator": "a[href*='price=1200-']",
      "fallbackLocators": [
        "a:has-text('Over 1200.00')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "Over 1200.00",
      "exact": true,
      "type": "link",
      "description": "Desktop price filter over 1200.00"
    },
    "accessoriesPriceUnder100": {
      "locator": "a[href*='price=-100']",
      "fallbackLocators": [
        "a:has-text('Under 100.00')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "Under 100.00",
      "exact": true,
      "type": "link",
      "description": "Accessories price filter under 100.00"
    },
    "accessoriesPriceOver100": {
      "locator": "a[href*='price=100-']",
      "fallbackLocators": [
        "a:has-text('Over 100.00')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "Over 100.00",
      "exact": true,
      "type": "link",
      "description": "Accessories price filter over 100.00"
    },
    "notebookIntelFilter": {
      "locator": "a[href*='specs=6']",
      "fallbackLocators": [
        "a:has-text('Intel')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "Intel",
      "exact": true,
      "type": "link",
      "description": "Notebook Intel CPU filter"
    },
    "notebookMemoryFilter": {
      "locator": "a[href*='specs=8']",
      "fallbackLocators": [
        "a:has-text('3 GB')"
      ],
      "strategy": "role",
      "role": "link",
      "name": "3 GB",
      "exact": true,
      "type": "link",
      "description": "Notebook 3 GB memory filter"
    },
    "notebookProductLink": {
      "locator": ".item-box .product-title a[href*='141-inch-laptop']",
      "strategy": "role",
      "role": "link",
      "name": "14.1-inch Laptop",
      "exact": true,
      "type": "link",
      "description": "14.1-inch Laptop product link"
    },

    "desktopProductDetailHeading": {
      "locator": "h1",
      "strategy": "role",
      "role": "heading",
      "name": "Build your own computer",
      "exact": true,
      "type": "heading",
      "description": "Desktop product detail heading"
    },
    "desktopProductDetailsForm": {
      "locator": "#product-details-form",
      "type": "form",
      "description": "Main configurable desktop product form"
    },
    "desktopProductDetailPrice": {
      "locator": "#product-details-form span.price-value-16",
      "type": "text",
      "description": "Configured desktop price scoped to the main product"
    },
    "ramSelect": {
      "locator": "#product-details-form select[name*='product_attribute_16_6']",
      "fallbackLocators": ["#product-details-form select[id*='product_attribute_16_6']", "#product-details-form select[name*='product_attribute_']:nth-of-type(2)", "#product-details-form select[id*='product_attribute_']:nth-of-type(2)", "#product-details-form select:has(option:has-text('GB'))"],
      "strategy": "css",
      "type": "select",
      "description": "RAM configuration selector"
    },
    "desktopHddOption": {
      "locator": "#product-details-form input[type='radio'][value='18']",
      "fallbackLocators": ["#product-details-form input[name*='product_attribute_'][value='18']", "#product-details-form input[type='radio']:has(+ label:has-text('320 GB'))"],
      "strategy": "css",
      "type": "radio",
      "description": "Required 320 GB HDD option"
    },
    "desktopQuantityInput": {
      "locator": "#product-details-form input#addtocart_16_EnteredQuantity",
      "strategy": "label",
      "name": "Qty:",
      "exact": true,
      "type": "textbox",
      "description": "Desktop product quantity input"
    },
    "desktopAddToCartButton": {
      "locator": "#product-details-form button[id*='add-to-cart'], #product-details-form input[id*='add-to-cart']",
      "fallbackLocators": [
        "#product-details-form .add-to-cart-button"
      ],
      "strategy": "css",
      "type": "button",
      "description": "Add configured desktop to cart"
    },

    "addToCartNotification": {
      "locator": "#bar-notification",
      "fallbackLocators": [".bar-notification", ".message-success", "[class*='notification']"],
      "type": "status",
      "description": "Add-to-cart success notification"
    },
    "cartCount": {
      "locator": "a.ico-cart .cart-qty, .cart-qty",
      "fallbackLocators": [".cart-count", "[data-testid='cart-count']", "a.ico-cart"],
      "strategy": "css",
      "type": "text",
      "description": "Shopping cart item count"
    },
    "cartProductRow": {
      "locator": ".cart-item-row",
      "type": "container",
      "description": "Desktop product row in the shopping cart"
    },
    "cartQuantityInput": {
      "locator": "input.qty-input",
      "fallbackLocators": ["input[class*='qty']", "input[name*='qty']"],
      "strategy": "label",
      "name": "Qty:",
      "exact": true,
      "type": "textbox",
      "description": "Quantity input in the shopping cart"
    },
    "viewModeDropdown": {
      "locator": "select[id*='products-viewmode']",
      "fallbackLocators": ["select[id*='viewmode']", ".view-mode select", "select[name*='viewmode']"],
      "strategy": "css",
      "type": "select",
      "description": "Catalogue view mode (Grid/List)"
    },
    "pageSizeDropdown": {
      "locator": "select[id*='products-pagesize']",
      "fallbackLocators": ["select[id*='pagesize']", ".page-size select", "select[name*='pagesize']"],
      "strategy": "css",
      "type": "select",
      "description": "Products per page"
    },
    "cardAddToCartButton": {
      "locator": ".product-box-add-to-cart-button",
      "strategy": "css",
      "type": "button",
      "description": "Add to cart button within a product card"
    },
    "cardCompareButton": {
      "locator": ".compare-button, .add-to-compare-list, a[href*='comparelist'], button:has-text('Add to compare list'), .product-box-add-to-compare, [class*='compare'], .compare-product, .add-to-compare",
      "fallbackLocators": ["[data-testid*='compare']", "a[title*='compare' i], button[title*='compare' i]", "a[href*='compare']"],
      "strategy": "css",
      "type": "button",
      "description": "Add to compare list button within a product card"
    },
    "productReviewLink": {
      "locator": "a[href*='productreviews']",
      "fallbackLocators": ["a:has-text('Reviews'), .product-review-link"],
      "strategy": "css",
      "type": "link",
      "description": "Product reviews link on detail page"
    },
    "emailFriendButton": {
      "locator": "a[href*='productemailafriend'], button:has-text('Email a friend')",
      "fallbackLocators": ["a:has-text('Email a friend'), .email-friend-button", "a[href*='emailafriend']", ".product-email-friend"],
      "strategy": "css",
      "type": "link",
      "description": "Email a friend button on detail page"
    },
    "desktopOsOption": {
      "locator": "#product-details-form input[type='radio'][value='19']",
      "fallbackLocators": ["#product-details-form input[name*='product_attribute_'][value='19']", "#product-details-form input[type='radio']:has(+ label:has-text('Windows 8 Pro'))"],
      "strategy": "css",
      "type": "radio",
      "description": "OS configuration option (Windows 8 Pro)"
    },
    "desktopSoftwareOptions": {
      "locator": "#product-details-form input[type='checkbox'][name*='product_attribute_']",
      "fallbackLocators": ["#product-details-form input[type='checkbox'][id*='product_attribute_']"],
      "strategy": "css",
      "type": "checkbox",
      "description": "Software configuration option (Microsoft Office)"
    }
  }
}